    <servers>
        <server>
            <id>tclake-repo</id>
            <username>QCI_USER</username>
            <password>QCI_PASSWORD</password>
        </server>
        <server>
            <id>tclake-snapshot-repo</id>
            <username>QCI_USER</username>
            <password>QCI_PASSWORD</password>
        </server>
        <server>
            <id>tclake</id>
            <username>QCI_USER</username>
            <password>QCI_PASSWORD</password>
        </server>
        <server>
            <id>tclake-snapshot</id>
            <username>QCI_USER</username>
            <password>QCI_PASSWORD</password>
        </server>
    </servers>

    <!-- 不配置 mirror：
         - 公共构件（org.apache:apache:pom 等）走 pom.xml 中声明的 central / gcs-maven-central-mirror / apache-releases 直连拉取
         - 腾讯内部 SNAPSHOT（tclake_plugins 等）走 tclake-snapshot-repo 直连拉取
         - 腾讯内部 release 走 tclake-repo 直连拉取
         外部 snapshot 仓库（apache.snapshots 等）的无效轮询仅产生 WARNING，不阻塞构建。 -->
    <!--
    <mirrors>
        <mirror>
            <id>tclake-mirror-all</id>
            <name>Tencent tclake maven mirror</name>
            <url>https://mirrors.tencent.com/repository/maven/tclake</url>
            <mirrorOf>external:*,!tclake-repo,!tclake-snapshot-repo</mirrorOf>
        </mirror>
    </mirrors>
    -->

    <offline>false</offline>

    <!-- 使用iOA免代理模式，或在devcloud开发机时，无需配置代理 -->
    <proxies>
        <!--如果使用iOA的NGN模式，建议使用如下代理配置
        <proxy>
          <id>NGN</id>
          <active>true</active>
          <protocol>http</protocol>
          <host>127.0.0.1</host>
          <port>12639</port>
          <nonProxyHosts>localhost|127.0.0.1</nonProxyHosts>
        </proxy>-->
    </proxies>

    <mirrors>
        <mirror>
            <id>maven-public</id>
            <mirrorOf>central</mirrorOf>
            <name>internal repository</name>
            <url>https://mirrors.tencent.com/nexus/repository/maven-public/</url>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>tencent</id>
            <repositories>
                <repository>
                    <id>maven_public</id>
                    <url>https://mirrors.tencent.com/nexus/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>tencent_public</id>
                    <url>https://mirrors.tencent.com/repository/maven/tencent_public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>thirdparty</id>
                    <url>https://mirrors.tencent.com/repository/maven/thirdparty/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>thirdparty-snapshots</id>
                    <url>https://mirrors.tencent.com/repository/maven/thirdparty-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>mqq</id>
                    <url>https://mirrors.tencent.com/repository/maven/mqq/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>tclake-release</id>
                    <name>tencent maven</name>
                    <url>https://mirrors.tencent.com/repository/maven/tclake</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>tclake-snapshot</id>
                    <name>tencent maven</name>
                    <url>https://mirrors.tencent.com/repository/maven/tclake-snapshot</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>maven-public</id>
                    <url>https://mirrors.tencent.com/nexus/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>tencent_public</id>
                    <url>https://mirrors.tencent.com/repository/maven/tencent_public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>

